{
  "compilerOptions": {
    // Alvos e módulos (essencial para o Render)
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": "./",
    
    // Essencial para imports como 'import express from "express"'
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    
    // Strict mode (recomendado)
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    
    // Outras opções úteis
    "sourceMap": true,
    "noUnusedLocals": false,  // Mude para true se quiser ser mais rigoroso
    "noUnusedParameters": false
  },
  "include": ["*.ts"],
  "exclude": ["node_modules", "dist"]
}